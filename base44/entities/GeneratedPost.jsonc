{
  "name": "GeneratedPost",
  "type": "object",
  "properties": {
    "link_id": {
      "type": "string",
      "description": "The affiliate link this post promotes"
    },
    "product_id": {
      "type": "string",
      "description": "Product this post promotes"
    },
    "product_name": {
      "type": "string",
      "description": "Product name for reference"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "linkedin",
        "tiktok",
        "twitter",
        "email",
        "general"
      ],
      "default": "general"
    },
    "content": {
      "type": "string",
      "description": "The generated post content"
    },
    "hashtags": {
      "type": "string",
      "description": "Suggested hashtags"
    },
    "tone": {
      "type": "string",
      "enum": [
        "inspiring",
        "urgent",
        "casual",
        "professional",
        "storytelling"
      ],
      "default": "inspiring"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "posted",
        "archived"
      ],
      "default": "draft"
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "ai_score": {
      "type": "number",
      "description": "AI quality score 1-10"
    },
    "ai_feedback": {
      "type": "string",
      "description": "AI notes on why this post should perform well"
    },
    "trending_topics": {
      "type": "string",
      "description": "Trending topics used in this post"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "passed",
        "modified",
        "flagged"
      ],
      "default": "passed",
      "description": "Community standards moderation result"
    },
    "moderation_notes": {
      "type": "string",
      "description": "JSON string with moderation details"
    },
    "autopilot_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this post is part of the simplified niche autopilot"
    },
    "autopilot_status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "weekly_winner",
        "paused"
      ],
      "description": "Current autopilot rotation state"
    },
    "niche": {
      "type": "string",
      "description": "Niche selected for autopilot generation"
    },
    "variant_number": {
      "type": "number",
      "description": "Ad variation number for a product"
    },
    "scheduled_day": {
      "type": "number",
      "description": "Day number this variant should run during the first test cycle"
    },
    "last_selected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this post was last selected by autopilot"
    },
    "week_starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current autopilot testing week"
    }
  },
  "required": [
    "content",
    "platform"
  ],
  "rls": {
    "create": {},
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "Payout",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this payout belongs to"
    },
    "amount": {
      "type": "number",
      "description": "Payout amount in dollars"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "bank_transfer",
        "check"
      ],
      "default": "paypal"
    },
    "payment_email": {
      "type": "string",
      "description": "PayPal or payment destination"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "Whether the payout was manually requested or created by auto-payout"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the payout was requested"
    },
    "notes": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ClickEvent",
  "type": "object",
  "properties": {
    "link_id": {
      "type": "string",
      "description": "Affiliate link that received the click"
    },
    "short_code": {
      "type": "string",
      "description": "Tracking short code used"
    },
    "product_name": {
      "type": "string",
      "description": "Cached product name"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the click happened"
    },
    "referrer": {
      "type": "string",
      "description": "Referring page or platform when available"
    },
    "source": {
      "type": "string",
      "description": "Optional source label"
    }
  },
  "required": [
    "link_id",
    "short_code",
    "clicked_at"
  ],
  "rls": {
    "create": {},
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
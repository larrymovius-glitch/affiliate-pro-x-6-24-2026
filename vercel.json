{
  "rewrites": [
    {
      "source": "/functions/trackClick",
      "destination": "/api/trackClick"
    },
    {
      "source": "/functions/trackConversion",
      "destination": "/api/trackConversion"
    },
    {
      "source": "/functions/ebayAccountDeletion",
      "destination": "/api/ebayAccountDeletion"
    },
    {
      "source": "/r/:code",
      "destination": "/api/trackClick?code=:code"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/processAutoPayouts",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/dailyPerformanceSummary",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/syncTrendingLinks",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/syncEbayTrending",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/optimizeAutopilotPosts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/refreshInstagramToken",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ]
}
